    <EmbeddedResource Include="..\css\style.css" Link="Resources\css\style.css" />
    <EmbeddedResource Include="..\js\calc.js" Link="Resources\js\calc.js" />
    <EmbeddedResource Include="..\js\combobox.js" Link="Resources\js\combobox.js" />
    <EmbeddedResource Include="..\js\data.js" Link="Resources\js\data.js" />
    <EmbeddedResource Include="..\js\worldstate.js" Link="Resources\js\worldstate.js" />
    <EmbeddedResource Include="..\js\relics.js" Link="Resources\js\relics.js" />
    <EmbeddedResource Include="..\js\market.js" Link="Resources\js\market.js" />
    <EmbeddedResource Include="..\js\settings.js" Link="Resources\js\settings.js" />
    <EmbeddedResource Include="..\data\relics_compact.json" Link="Resources\data\relics_compact.json" />
    <EmbeddedResource Include="..\data\wfm_items.json" Link="Resources\data\wfm_items.json" />
